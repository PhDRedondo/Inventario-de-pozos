{
  "_comment": "Plantilla de producción para la OTI. Copiar a appsettings.Production.json y reemplazar los <PLACEHOLDERS>. NO commitear el archivo con secretos: use variables de entorno o Azure Key Vault para User/Password.",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "vip.anh.gov.co",
  "UseInMemoryDatabase": false,
  "ConnectionStrings": {
    "VipDb": "Server=<SQL_INSTANCE>;Database=VIP_Inventario;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=True"
  },
  "Oidc": {
    "Authority": "https://login.microsoftonline.com/<TENANT_ID>/v2.0",
    "Audience": "api://anh-vip"
  },
  "Smtp": {
    "Host": "<SMTP_HOST>",
    "Port": 587,
    "EnableSsl": true,
    "From": "vip@anh.gov.co",
    "AnhRecipient": "inventariopozos@anh.gov.co",
    "User": "",
    "Password": ""
  }
}
