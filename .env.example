# Copiar a .env.local para desarrollo. En Vercel configurar las mismas claves.

# ≥32 caracteres. Si se omite, el piloto usa un fallback local.
SESSION_SECRET=local-dev-only-session-secret-min-32chars!

# Contraseña de acceso piloto (admin). Si se omite: local-demo-password
ANH_ADMIN_PASSWORD=local-demo-password

# false solo para apagar el botón/usuarios demo.
DEMO_LOGIN_ENABLED=true

# Contraseña ANH/operadora demo. Si se omite: local-demo-password
DEMO_PASSWORD=local-demo-password
