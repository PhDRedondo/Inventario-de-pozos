# Copiar a .env.local para desarrollo. En Vercel configurar las mismas claves.

# Obligatorio en producción (≥32 caracteres). Generar: openssl rand -hex 32
SESSION_SECRET=local-dev-only-session-secret-min-32chars!

# Obligatorio en producción (≥10 caracteres). Semilla del admin institucional.
# Dev default en código si se omite: local-dev-admin-change-me
ANH_ADMIN_PASSWORD=local-dev-admin-change-me

# false en producción/mesa OTI. true solo para demos controladas.
DEMO_LOGIN_ENABLED=true

# ANH/operadora demo. Dev default en código si se omite: local-demo-password
# Obligatorio si DEMO_LOGIN_ENABLED=true en producción.
DEMO_PASSWORD=local-demo-password
